{
  "tasks": {
    "vfs": "deno run --allow-env --allow-read --allow-write vfs.ts",
    "main": "deno run --allow-env --allow-read --allow-ffi main.ts",
    "root": "deno run --allow-env --allow-read src/root.ts",
    "action": "deno run --allow-env --allow-read src/action.ts",
    "dist": "deno run dist/src/root.ts",
    "sig": "deno run --allow-env --allow-read signature.ts"
  },
  "imports": {
    "effect": "npm:effect@^3.17.13",
    "@effect/platform": "npm:@effect/platform@^0.94.0",
    "@effect/platform-node": "npm:@effect/platform-node@^0.104.0",
    "typescript": "npm:typescript@^5.9.3"
  },
  "nodeModulesDir": "auto",
  "allowScripts": {
    "allow": ["npm:@parcel/watcher@2.5.1", "npm:esbuild@0.27.2", "npm:msgpackr-extract@3.0.3"],
    "deny": []
  }
}